[Unit]
Description=Bluetooth Service
Requires=basic.target
Conflicts=
Wants=synergy.service a2dp-player.service bt-audio.service
After=basic.target rescue.service rescue.target
AllowIsolate=yes

[Install]
Alias=default.target
